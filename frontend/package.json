{
  "name": "kivu-immobilier-frontend",
  "version": "1.0.0",
  "description": "Frontend Kivu Immobilier avec React et esbuild",
  "main": "src/index.jsx",
  "scripts": {
    "dev": "concurrently \"node build.js --serve\" \"npx tailwindcss -i ./src/styles/index.css -o ./public/dist/app.css --watch\"",
    "build": "npx tailwindcss -i ./src/styles/index.css -o ./public/dist/app.css --minify && node build.js"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "ethers": "^6.17.0",
    "framer-motion": "^11.11.0",
    "leaflet": "^1.9.4",
    "lucide-react": "*",
    "pannellum": "^2.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.24.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19"
  },
  "author": "Kivu Immobilier Team",
  "license": "ISC"
}
