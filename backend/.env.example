# Modèle de configuration pour KivuMarket+
# Copier ce fichier en .env et remplir les valeurs

# ─── PHPMailer / Gmail SMTP ──────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre-email@gmail.com
MAIL_PASSWORD=votre-app-password-gmail
MAIL_FROM=votre-email@gmail.com
MAIL_FROM_NAME=KivuMobilier

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_URL=http://localhost/kivumarket/backend/public/index.php

# ─── Base de données (XAMPP par défaut) ──────────────────────────────────────
DB_HOST=localhost
DB_NAME=kivumarket
DB_USER=root
DB_PASS=

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=KivuMarketSecretKey2026!
JWT_EXPIRE=86400

# ─── Blockchain GoChain / Sepolia ─────────────────────────────────────────────
ETH_RPC_URL=https://testnet-rpc.gochain.io
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
ADMIN_WALLET=0x0000000000000000000000000000000000000000

# ─── Google Cloud Storage (optionnel, pour production) ────────────────────────
GCS_BUCKET=
GCS_KEY_FILE=
